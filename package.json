    "prisma": {
        "seed": "node -r ts-node/register prisma/seed/index.ts"
    },
    "scripts": {
        "postinstall": "npx prisma generate",
        "prebuild": "node -e \"const fs=require('node:fs'),p=require('node:path');try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){if(e.code==='EBUSY'){for(const f of fs.readdirSync('dist'))fs.rmSync(p.join('dist',f),{recursive:true,force:true})}else throw e}\"",
        "build": "webpack --mode production",
        "format": "prettier --write \"src/**/*.ts\"",
        "watch": "webpack --mode development --watch",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/server",
        "start:debug": "nest start --watch",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "husky:install": "husky install",
        "prisma:init": "npx prisma init",
        "prisma:generate": "npx prisma generate",
        "migration:generate": "npx prisma migrate dev --create-only --name",
        "db:migrate:dev": "npx prisma migrate dev",
        "db:push": "echo '⚠️  WARNING: db:push should NEVER be used on production. Use db:migrate:prod instead.' && npx prisma db push",
        "db:seed": "npx prisma db seed",
        "db:pull": "npx prisma db pull",
        "db:migrate:prod": "npx prisma migrate deploy",
        "db:studio": "npx prisma studio",
        "db:backup": "node scripts/backup-utils.js backup",
        "db:backup:list": "node scripts/backup-utils.js list",
        "db:backup:restore": "node scripts/backup-utils.js restore",
        "db:backup:help": "node scripts/backup-utils.js help",
        "nomba:replay:local": "node scripts/replay-local-nomba-webhook.js",
        "db:pre-check": "npx ts-node prisma/scripts/pre-migrate-check.ts",
        "db:staging:up": "docker compose -f docker-compose.staging.yml up -d",
        "db:staging:down": "docker compose -f docker-compose.staging.yml down",
        "db:staging:logs": "docker compose -f docker-compose.staging.yml logs -f"
    },
