    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/__tests__/**",
            "!**/*.spec.ts",
            "!**/*.mock.ts",
            "!**/mocks/**",
            "!**/test/**",
            "!main.ts",
            "!prisma/**"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "globals": {
            "ts-jest": {
                "diagnostics": false
            }
        },
        "moduleNameMapper": {
