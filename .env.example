# ========================================
# RESOLVE WEB SERVICES - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ========================================

# ========================================
# APPLICATION SETTINGS
# ========================================
PORT=3500
NODE_ENV=development
ENVIRONMENT=development
BASEURL=http://localhost:3500

# Comma-separated list of allowed frontend domains
ALLOWED_DOMAINS=http://localhost:3000,http://localhost:3008
FRONTEND_DEV_DOMAIN=http://localhost:3008

# Comma-separated ISO country codes for blocked countries
BLOCKED_COUNTRIES=AF,BY,BA,CF,CU,CD,ER,GW,IR,IQ,CI,LA,LB,LR,LY,MM,NI,KP,PK,GN,RS,SO,LK,SS,SD,SY,TT,VU,VE,YE,CN,HT,ML,MD,RU,UA,ZW

# ========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"
SHADOW_DATABASE_URL="postgresql://username:password@host:port/shadow_database?sslmode=require"

# ========================================
# SECURITY & ENCRYPTION
# ========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-min-32-chars
ENCRYPT_SECRET=your-encryption-secret-key-min-32-chars

# ========================================
# REDIS CACHE CONFIGURATION
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your-redis-password

# ========================================
# CLOUDINARY (IMAGE STORAGE)
# ========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========================================
# IMAGEKIT (IMAGE DELIVERY)
# ========================================
IMAGEKIT_URL=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_PUBLIC_KEY=public_your-public-key
IMAGEKIT_PRIVATE_KEY=private_your-private-key

# Upload directories
PROFILE_DIR=ResolveProfile
DOCUMENT_DIR=ResolveDocument

# ========================================
# DOJAH (IDENTITY VERIFICATION)
# ========================================
# Sandbox URL: https://sandbox.dojah.io/
# Production URL: https://api.dojah.io/
DOJAH_BASE_URL=https://sandbox.dojah.io/
DOJAH_APP_ID=your-dojah-app-id
DOJAH_PUBLIC_KEY=your-dojah-public-key
DOJAH_SECRET_KEY=your-dojah-secret-key
DOJAH_TOKEN_ID=your-dojah-token-id

# ========================================
# PAYSTACK (PAYMENT PROCESSING)
# ========================================
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_CALLBACK_URL=http://localhost:3008?buy=success
PAYSTACK_CANCEL_ACTION=http://localhost:3008/cancel

# ========================================
# QUIDAX (CRYPTO TRADING)
# ========================================
QUIDAX_BASE_URL=https://app.quidax.io/api/v1
QUIDAX_RAMP_BASEURL=https://ramp-be.quidax.io/api/v1/merchants
QUIDAX_API_PUBLIC=your-quidax-public-key
QUIDAX_API_SECRET=your-quidax-secret-key
QUIDAX_WEBHOOK_KEY=your-quidax-webhook-secret

# ========================================
# ZEPTOMAIL (EMAIL SERVICE)
# ========================================
ZEPTOMAIL_URL=api.zeptomail.com/
ZEPTOMAIL_TOKEN="Zoho-enczapikey your-zeptomail-api-key"
ZEPTOMAIL_SENDER=noreply@yourdomain.com

# Email Template IDs (from ZeptoMail dashboard)
REGISTRATION_SUCCESS_TEMPLATE=your-registration-template-id
VERIFY_ACCOUNT_TEMPLATE=your-verification-template-id
FORGOT_PASSWORD_TEMPLATE=your-forgot-password-template-id
RECOVERY_PIN_TEMPLATE=your-recovery-pin-template-id
TRANSACTION_NOTIFICATION_TEMPLATE=your-transaction-notification-template-id
FAILED_TRANSACTION_TEMPLATE=your-failed-transaction-template-id
