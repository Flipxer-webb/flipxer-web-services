# ============================================================
# FLIPXER BACKEND - Environment Variables Template
# ============================================================
# SECURITY: Never commit real credentials to version control!
# Copy this file to .env and fill in your values.
# For production, set these in your deployment platform (Render).
# ============================================================

# ==================== APPLICATION ====================
PORT=3500
NODE_ENV=development
ENVIRONMENT=development
BASEURL=http://localhost:3500
ALLOWED_DOMAINS=http://localhost:3000,http://localhost:3008
FRONTEND_DEV_DOMAIN=http://localhost:3008
FRONTEND_URL=http://localhost:3008

# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/flipxer_dev
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/flipxer_dev
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/flipxer_shadow

# ==================== SECURITY ====================
# Generate these with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-64-byte-hex-secret-here
JWT_REFRESH_SECRET=generate-64-byte-hex-secret-here
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPT_SECRET=generate-32-byte-hex-secret-here

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false
# Set to true to disable Redis in development (uses in-memory cache)
REDIS_DISABLED=false

# ==================== EMAIL (ZeptoMail) ====================
ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=your-zeptomail-token
ZEPTOMAIL_SENDER=noreply@yourdomain.com

# Email Templates (ZeptoMail template keys)
REGISTRATION_SUCCESS_TEMPLATE=your-template-key
VERIFY_ACCOUNT_TEMPLATE=your-template-key
FORGOT_PASSWORD_TEMPLATE=your-template-key
RECOVERY_PIN_TEMPLATE=your-template-key
TRANSACTION_NOTIFICATION_TEMPLATE=your-template-key
FAILED_TRANSACTION_TEMPLATE=your-template-key
DOCUMENT_APPROVED_TEMPLATE=your-template-key
DOCUMENT_REJECTED_TEMPLATE=your-template-key

# ==================== SMS (Sendchamp) ====================
SENDCHAMP_ACCESS_KEY=your-sendchamp-access-key
SENDCHAMP_SENDER_ID=Flipxer
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1

# ==================== STORAGE ====================
# ImageKit
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL=https://ik.imagekit.io/your-id

# Cloudinary (optional fallback)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Storage directories
PROFILE_DIR=profile-images
DOCUMENT_DIR=user-documents

# ==================== IDENTITY VERIFICATION (Dojah) ====================
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=your-dojah-app-id
DOJAH_PUBLIC_KEY=your-dojah-public-key
DOJAH_SECRET_KEY=your-dojah-secret-key
DOJAH_TOKEN_ID=your-dojah-token-id

# ==================== PAYMENT GATEWAY (Fincra) ====================
FINCRA_BASE_URL=https://api.fincra.com
FINCRA_SECRET_KEY=your-fincra-secret-key
FINCRA_PUBLIC_KEY=your-fincra-public-key
FINCRA_BUSINESS_ID=your-business-id
FINCRA_REDIRECT_URL=http://localhost:3008/payment/callback
FINCRA_WEBHOOK_SECRET=your-webhook-secret
# Optional proxy for IP whitelisting
FINCRA_PROXY_URL=

# ==================== CRYPTO TRADING (Quidax) ====================
QUIDAX_BASE_URL=https://app.quidax.io
QUIDAX_RAMP_BASEURL=https://ramp-be.quidax.io
QUIDAX_API_PUBLIC=your-quidax-public-key
QUIDAX_API_SECRET=your-quidax-secret-key
QUIDAX_WEBHOOK_KEY=your-quidax-webhook-key

# ==================== PRICE DATA ====================
LIVECOINWATCH_API_KEY=your-livecoinwatch-api-key

# ==================== PUSH NOTIFICATIONS (Firebase) ====================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key including -----BEGIN PRIVATE KEY----- markers
# Escape newlines as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ==================== GEO-BLOCKING ====================
# Comma-separated list of ISO country codes to block
BLOCKED_COUNTRIES=US,GB,CA

# ==================== NOMBA (Optional Alternative Gateway) ====================
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_CLIENT_ID=your-client-id
NOMBA_CLIENT_SECRET=your-client-secret
NOMBA_ACCOUNT_ID=your-account-id
NOMBA_WEBHOOK_SECRET=your-webhook-secret

# ==================== ALERTING ====================
SLACK_PAYOUT_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ==================== WEBAUTHN/PASSKEYS ====================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Flipxer
WEBAUTHN_ORIGIN=http://localhost:3008

# ==================== TEST / SEED SCRIPTS ====================
# Required for prisma seed and test user creation scripts
TEST_USER_PASSWORD=TestUser@2024!
TEST_ADMIN_PASSWORD=TestAdmin123!
TEST_PASSWORD=TestPassword123!
TEST_TIER0_PASSWORD=TierZero@2024!
TEST_TIER1_PASSWORD=TierOne@2024!
TEST_TIER2_PASSWORD=TierTwo@2024!
NEW_ADMIN_PASSWORD=ChangeMe123!
