  approvedBy    Int?           // Super-admin who approved
  rejectedBy    Int?           // Super-admin who rejected
  rejectionNote String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  ledgerEntryId String?        // Created when approved
  createdAt     DateTime       @default(now())
