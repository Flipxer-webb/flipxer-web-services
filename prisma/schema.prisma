generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                                 Int                               @id @default(autoincrement())
  identifier                         String                            @unique
  firstName                          String?
  lastName                           String?
  businessName                       String?
  username                           String?
  middleName                         String?
  email                              String                            @unique
  phone                              String?                           @unique
  password                           String?
  passwordChangedAt                  DateTime?
  userType                           UserType
  photo                              String?
  gender                             Gender?
  dateOfBirth                        DateTime?
  residentialAddress                 String?
  status                             Status                            @default(ACTIVE)
  roleId                             Int
  ipAddress                          String?
  notificationToken                  String?
  isDeleted                          Boolean                           @default(false)
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  lastLogin                          DateTime?
  loginCount                         Int                               @default(0)
  businessDocumentVerificationStatus DocumentVerificationStatus?
  businessRecordCompleted            Boolean                           @default(false)
  bvn                                String?                           @unique
  bvnRegisteredPhone                 String?
  country                            Country                           @default(NIGERIA)
  isDocumentVerified                 Boolean                           @default(false)
  isEmailVerified                    Boolean                           @default(false)
  isPasswordCreated                  Boolean                           @default(false)
  isPhoneVerified                    Boolean                           @default(false)
  cryptoSubAccountId                 String?                           @unique
  refreshToken                       String?
  refreshTokenFamily                 String?                           // UUID family for token rotation/reuse detection
  businessDocumentsUploaded          Boolean                           @default(false)
  recoveryEmail                      String?
  photoFileId                        String?
  flaggedId                          Int?                              @unique
  nin                                String?                           @unique
  ninRegisteredPhone                 String?
  isTwoFactorEnabled                 Boolean                           @default(false)
  tier                               Int                               @default(0)
  twoFactorSecret                    String?
  // Multi-factor security settings
  securityMethods                    Json?                             // {sms, email, authenticator, tradingPassword}
  requiredMethodCount                Int                               @default(1)
  // Tier 2/3 verification fields
  documentVerificationStatus         DocumentVerificationStatus?       // Identity document verification status
  addressDocumentUrl                 String?
  incomeDocumentUrl                  String?
  tradingPassword                    String?
  // Account lockout for brute force protection
  failedLoginAttempts                Int                               @default(0)
  lastFailedLogin                    DateTime?
  lockedUntil                        DateTime?
  accountLimit                       AccountLimit?
  allowedIps                         AllowedIp[]
  assetWallets                       AssetWallet[]
  auditLogs                          AuditLog[]                        @relation("AdminAuditLogs")
  bankDetails                        BankDetail[]
  businessDocument                   BusinessDocument?
  businessRecord                     BusinessRecord?
  cryptoWalletAddressList            CryptoWalletAddress[]
  dailyTransactions                  DailyTransaction[]                @relation("UserToDailyTransaction")
  flaggedRecord                      Flagged?                          @relation("UserToFlagged")
  limitOverride                      LimitOverride?                    @relation("UserToLimitOverride")
  monthlyTransactions                MonthlyTransaction[]              @relation("UserToMonthlyTransaction")
  sentNotifications                  Notification[]                    @relation("senderNotification")
  receiverNotifications              Notification[]                    @relation("receiverNotification")
  order                              Order[]
  passwordResetRequest               PasswordResetRequest?
  payments                           Payment[]
  RecoveryEmailVerificationRequest   RecoveryEmailVerificationRequest?
  adminInvitesSent                   AdminInvite[]                     @relation("AdminInvitesSent")
  sessions                           Session[]
  userDocument                       UserDocument?
  preferences                        UserPreferences?
  notificationPreferences            NotificationPreferences?
  priceAlerts                        PriceAlert[]
  deviceTokens                       DeviceToken[]

  role                               Role                              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Virtual Balance / Ledger System relations
  ledgerEntries                      LedgerEntry[]
  withdrawalQueues                   WithdrawalQueue[]
  orphanedHoldReviews                OrphanedHoldReview[]              @relation("OrphanedHoldResolver")
  depositReviewQueues                DepositReviewQueue[]
  depositReviewsReviewed             DepositReviewQueue[]              @relation("DepositReviewer")
  kycStageAttempts                   KycStageAttempt[]
  kycAttemptEvents                   KycAttemptEvent[]
  failedRollbacks                    FailedRollback[]
  backupCodes                        TwoFactorBackupCode[]
  // Identity deduplication
  identitySubjectId                  Int?                              @unique
  identitySubject                    IdentitySubject?                  @relation(fields: [identitySubjectId], references: [id], onDelete: SetNull)
  // Additional performance indexes
  @@index([email, isDeleted])
  @@index([phone, isDeleted])
  @@index([isDocumentVerified])
  @@index([tier])
  @@index([status])
  @@index([createdAt])
  @@map("Users")
}

model Session {
  id             String    @id @default(uuid())
  userId         Int
  deviceName     String?
  deviceType     String?
  browser        String?
  os             String?
  ipAddress      String?
  location       String?
  isActive       Boolean   @default(true)
  isCurrent      Boolean   @default(false)
  isBotSession   Boolean   @default(false)
  lastActiveAt   DateTime  @default(now())
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive, lastActiveAt(sort: Desc)])
  @@index([isBotSession])
  @@map("Sessions")
}

model TwoFactorBackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("TwoFactorBackupCodes")
}


model UserPreferences {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  theme               String   @default("system") // "light" | "dark" | "system"
  defaultFiatCurrency String   @default("NGN")
  favoriteAssets      String[] @default([]) // Array of currency codes
  quickActionOrder    String[] @default([]) // Manual override for action ordering
  quickActionUsage    Json?    // { buy: 45, sell: 30, swap: 12, send: 5, receive: 8 }
  hideZeroBalances    Boolean  @default(false)
  dashboardLayout     Json?    // Widget order preferences
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserPreferences")
}

model NotificationPreferences {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  emailTransactions   Boolean  @default(true)
  emailMarketing      Boolean  @default(false)
  emailSecurityAlerts Boolean  @default(true)
  pushTransactions    Boolean  @default(true)
  pushPriceAlerts     Boolean  @default(true)
  pushSecurityAlerts  Boolean  @default(true)
  pushMarketing       Boolean  @default(false)
  soundEnabled        Boolean  @default(true)
  quietHoursEnabled   Boolean  @default(false)
  quietHoursStart     String?  // "22:00" in 24hr format
  quietHoursEnd       String?  // "07:00" in 24hr format
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("NotificationPreferences")
}

model DeviceToken {
  id          Int      @id @default(autoincrement())
  userId      Int
  token       String
  deviceName  String?  // e.g., "Chrome on Windows", "Safari on iPhone"
  platform    String?  // "web", "android", "ios"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([token])
  @@map("DeviceTokens")
}

model PriceAlert {
  id          Int            @id @default(autoincrement())
  userId      Int
  currency    String         // e.g., "BTC", "ETH"
  targetPrice Float          // Target price in user's default fiat currency
  direction   PriceDirection // ABOVE or BELOW
  isActive    Boolean        @default(true)
  triggeredAt DateTime?      // When the alert was triggered
  expiresAt   DateTime?      // Optional expiration date
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([currency])
  @@map("PriceAlerts")
}

enum PriceDirection {
  ABOVE
  BELOW
}

model TransactionOTP {
  id        Int      @id @default(autoincrement())
  userId    Int
  method    String   // "sms" or "email"
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, method])
  @@index([userId])
  @@map("TransactionOTPs")
}

model Flagged {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  flagged   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToFlagged", fields: [userId], references: [id], onDelete: Cascade)

  @@map("Flagged")
}

model LimitOverride {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  dailyLimitUSD      Float?    // null = use tier default, value = override in USD
  reason             String    // Why the override was granted
  grantedBy          Int       // Admin user ID who set the override
  expiresAt          DateTime? // null = permanent until removed
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation("UserToLimitOverride", fields: [userId], references: [id], onDelete: Cascade)

  @@map("LimitOverrides")
}

model DailyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  day       Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToDailyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, day])
  @@map("DailyTransactions")
}

model MonthlyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToMonthlyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("MonthlyTransactions")
}

model AccountLimit {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  sellTokenFiat Int?     @default(50000)
  buyToken      String?  @default("unlimited")
  swapToken     String?  @default("unlimited")
  sendToken     Int?     @default(50000)
  receiveToken  String?  @default("unlimited")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AccountLimits")
}

model BankDetail {
  id            Int      @id @default(autoincrement())
  userId        Int
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankCode      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([accountNumber])
  @@index([bankCode, accountNumber])
  @@map("BankDetails")
}

model BusinessRecord {
  id                           Int    @id @default(autoincrement())
  userId                       Int?   @unique
  businessName                 String
  natureOfBusiness             String
  taxIdentificationNumber      String
  expectedTransactionVolume    String
  expectedTransactionFrequency String
  user                         User?  @relation(fields: [userId], references: [id])

  @@map("BusinessRecords")
}

model UserDocument {
  id                       Int                         @id @default(autoincrement())
  userId                   Int?                        @unique
  type                     DocumentType
  country                  Country
  documentNumber           String
  documentImageUrl         String
  documentImageFieldId     String
  documentImage2FieldId    String?
  documentImageUrl2        String?
  // Dojah verification fields
  verificationStatus       DocumentVerificationStatus  @default(PENDING)
  dojahVerified            Boolean                     @default(false)
  dojahDocumentType        String?                     // e.g., "International Passport - Nigeria"
  dojahCountryCode         String?                     // e.g., "NGA"
  dojahExtractedFirstName  String?
  dojahExtractedLastName   String?
  dojahExtractedDob        String?
  dojahExtractedDocNumber  String?
  dojahExtractedExpiryDate String?                     // Document expiry date from Dojah
  dojahNameMatches         Boolean?
  dojahVerifiedAt          DateTime?
  dojahRawResponse         String?                     // JSON string of full response for audit
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  user                     User?                       @relation(fields: [userId], references: [id])

  @@map("UserDocuments")
}

model BusinessDocument {
  id                                                  Int     @id @default(autoincrement())
  userId                                              Int?    @unique
  cacDocumentNumber                                   String
  cacImageUrl                                         String
  articleOfAssociationNumber                          String?
  articleOfAssociationImageUrl                        String?
  proofOfAddressForBeneficialOwner                    String?
  articleOfAssociationImageUrlFieldId                 String?
  boardResolutionAuthorizedAcctOpeningImageUrl        String?
  boardResolutionAuthorizedAcctOpeningImageUrlFieldId String?
  cacImageUrlFieldId                                  String
  meansOfIdentificationForBeneficialOwner             String?
  meansOfIdentificationForBeneficialOwnerImageFieldId String?
  proofOfAddressForBeneficialOwnerImageFieldId        String?
  articleOfAssociationFileName                        String?
  boardResolutionAuthorizedAcctOpeningFileName        String?
  cacImageFileName                                    String?
  meansOfIdentificationForBeneficialOwnerFileName     String?
  proofOfAddressForBeneficialOwnerFileName            String?

  // Expanded business KYC document set (company-level)
  certificateOfIncorporationUrl                        String?
  certificateOfIncorporationFieldId                    String?
  certificateOfIncorporationFileName                   String?
  applicationForRegistrationUrl                        String?
  applicationForRegistrationFieldId                    String?
  applicationForRegistrationFileName                   String?
  memartUrl                                            String?
  memartFieldId                                        String?
  memartFileName                                       String?
  companyUtilityBillsUrl                               String?
  companyUtilityBillsFieldId                           String?
  companyUtilityBillsFileName                          String?
  companyAmlPolicyUrl                                  String?
  companyAmlPolicyFieldId                              String?
  companyAmlPolicyFileName                             String?
  scumlCertificateUrl                                  String?
  scumlCertificateFieldId                              String?
  scumlCertificateFileName                             String?
  companyOrganogramUrl                                 String?
  companyOrganogramFieldId                             String?
  companyOrganogramFileName                            String?
  companyLicenseUrl                                    String?
  companyLicenseFieldId                                String?
  companyLicenseFileName                               String?
  flowsBusinessFundsUrl                                String?
  flowsBusinessFundsFieldId                            String?
  flowsBusinessFundsFileName                           String?

  // Company info text fields
  companyWebsite                                       String?
  companyTaxId                                         String?
  companyAddress                                       String?
  natureOfBusiness                                     String?
  purposeOfTransaction                                 String?
  purposeOfTransactionOther                            String?

  // Dojah CAC Lookup verification
  cacVerified                                         Boolean  @default(false)
  cacVerifiedAt                                       DateTime?
  cacCompanyName                                      String?
  cacCompanyStatus                                    String?
  cacRegistrationDate                                 String?
  cacNameMatches                                      Boolean?
  cacRawResponse                                      String?  @db.Text

  // Dojah TIN verification
  tinVerified                                         Boolean  @default(false)
  tinVerifiedAt                                       DateTime?
  tinTaxpayerName                                     String?
  tinNameMatches                                      Boolean?
  tinRawResponse                                      String?  @db.Text

  // Dojah CAC Document OCR verification
  cacOcrVerified                                      Boolean  @default(false)
  cacOcrVerifiedAt                                    DateTime?
  cacOcrExtractedNumber                               String?
  cacOcrExtractedName                                 String?
  cacOcrNumberMatches                                 Boolean?
  cacOcrRawResponse                                   String?  @db.Text

  user                                                User?   @relation(fields: [userId], references: [id])
  directors                                           BusinessDirector[]
  shareholders                                        BusinessShareholder[]

  @@map("BusinessDocuments")
}

model BusinessDirector {
  id                Int              @id @default(autoincrement())
  businessDocumentId Int
  fullName          String
  nationality       String
  dateOfBirth       DateTime
  residentialAddress String
  businessAddress   String
  nin               String?
  idDocumentUrl     String?
  idDocumentFieldId String?
  idDocumentFileName String?
  proofOfAddressUrl String?
  proofOfAddressFieldId String?
  proofOfAddressFileName String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessDocument  BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)

  @@index([businessDocumentId])
  @@map("BusinessDirectors")
}

model BusinessShareholder {
  id                Int              @id @default(autoincrement())
  businessDocumentId Int
  fullName          String
  nationality       String
  dateOfBirth       DateTime
  residentialAddress String
  businessAddress   String
  nin               String?
  ownershipPercentage Float
  idDocumentUrl     String?
  idDocumentFieldId String?
  idDocumentFileName String?
  proofOfAddressUrl String?
  proofOfAddressFieldId String?
  proofOfAddressFileName String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessDocument  BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)

  @@index([businessDocumentId])
  @@map("BusinessShareholders")
}

model AccountVerificationRequest {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([email, code])
  @@index([email, code])
  @@map("AccountVerificationRequests")
}

model PhoneVerificationRequest {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([phone, code])
  @@index([phone, code])
  @@map("PhoneVerificationRequests")
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  slug           String           @unique
  description    String?
  isAdmin        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rolePermission RolePermission[]
  adminInvites   AdminInvite[]
  users          User[]

  @@map("Roles")
}

model PasswordResetRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("PasswordResetRequests")
}

model AdminInvite {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  email       String
  firstName   String
  lastName    String
  roleId      Int
  invitedById Int
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  role        Role      @relation(fields: [roleId], references: [id])
  invitedBy   User      @relation("AdminInvitesSent", fields: [invitedById], references: [id])

  @@index([email, acceptedAt])
  @@map("AdminInvites")
}

model Permission {
  id          Int              @id @default(autoincrement())
  group       PermissionGroup
  name        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("RolePermissions")
}

model AssetWallet {
  id                String   @id @default(uuid())
  userId            Int
  quidaxWalletId    String   @unique
  assetName         String
  assetCurrency     String
  balance           Decimal  @db.Decimal(20, 18)
  locked            Decimal  @db.Decimal(20, 18)
  staked            Decimal  @db.Decimal(20, 18)
  convertedBalance  Decimal  @db.Decimal(20, 8)
  referenceCurrency String
  isCrypto          Boolean
  defaultNetwork    String
  blockchainEnabled Boolean
  depositAddress    String?
  destinationTag    String?
  isActive          Boolean  @default(false)
  addressSynced     Boolean  @default(false)
  networks          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, assetCurrency])
  @@index([userId])
  @@index([assetCurrency])
  @@index([userId, isActive])
  @@map("AssetWallets")
}

model CryptoWalletAddress {
  id              Int                @id @default(autoincrement())
  userId          Int
  assetSymbol     String
  walletAddressId String             @unique
  address         String?
  totalPayments   Decimal            @default(0.0)
  lastSyncedAt    DateTime?
  network         NetworkTypes?
  destination_tag String?
  status          CryptoWalletStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])

  @@unique([userId, assetSymbol, network])
  @@index([userId, assetSymbol])
  @@map("CryptoWalletAddresses")
}

model Order {
  id                           Int                    @id @default(autoincrement())
  userId                       Int
  orderCategory                OrderCategory
  market                       String?
  orderType                    OrderType?
  orderSide                    OrderSide?
  volume                       Float?
  price                        Float?
  status                       OrderStatus
  quotationId                  String?
  fromCurrency                 String?
  toCurrency                   String?
  fromAmount                   Float?
  toAmount                     Float?
  quoted_price                 Float?
  quoted_currency              String?
  executionPrice               Float?
  swapExpiresAt                DateTime?
  currency                     String?
  narration                    String?
  reason                       String?
  transaction_note             String?
  recipient                    String?
  amount                       Float?
  fee                          Float?
  total                        Float?
  sourceType                   String?
  blockchain_txid              String?
  providerOrderId              String?                @unique
  orderReference               String?                @unique
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  destinationBankAccountName   String?
  destinationBankAccountNumber String?
  destinationBankCode          String?
  destinationBankName          String?
  destinationTag               String?
  paymentStatus                TransactionStatus?
  totalToReceiveInFiat         Float?
  amountInFiat                 Float?
  rateAtConversion             Float?
  estimatedProfit              Float?                 // Estimated profit in fiat (Value In - Value Out)
  referenceFiatCurrency        ReferenceFiatCurrency  @default(NGN)
  sender                       String?
  streamlinedStatus            OrderStreamlinedStatus @default(pending)
  transactionId                String?                @unique
  network                      String?                // Blockchain network (send/receive) for receipt
  paymentMethod                String?                // Payment method or sender name (buy/sell) for receipt
  fulfilled                    Boolean                @default(false) // Set to true when BUY order crypto has been delivered
  // Virtual Balance / Ledger System
  ledgerEntryId                String?                // Link to main ledger entry for this order
  user                         User                   @relation(fields: [userId], references: [id])
  payments                     Payment[]
  failedRollbacks              FailedRollback[]
  // Single column indexes
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([streamlinedStatus])
  @@index([orderCategory])
  @@index([currency])
  @@index([fromCurrency])
  @@index([toCurrency])
  // Composite indexes for common query patterns
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, streamlinedStatus])
  @@index([userId, orderCategory])
  @@map("Orders")
}

model Bank {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  code      String   @unique
  longCode  String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Banks")
}

model CryptoRate {
  id        Int      @id @default(autoincrement())
  currency  String   @unique
  buyRate   Float    @default(0)
  sellRate  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("CryptoRates")
}

model SwapPair {
  id           Int      @id @default(autoincrement())
  fromCurrency String
  toCurrency   String
  rate         Float    @default(0) // Admin set rate: 1 From = X To
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("SwapPairs")
}

model TransactionFee {
  id        Int                    @id @default(autoincrement())
  category  TransactionFeeCategory
  currency  String
  fee       Float                  @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([category, currency])
  @@map("TransactionFees")
}

model Payment {
  id                           Int               @id @default(autoincrement())
  userId                       Int
  orderId                      Int?
  amount                       Decimal           @db.Decimal(10, 2)
  chargeFee                    Decimal           @default(0.0) @db.Decimal(10, 2)
  totalAmount                  Decimal?          @db.Decimal(10, 2)
  expectedCurrency             String?
