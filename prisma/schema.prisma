// =============================================================================
// VIRTUAL BALANCE / LEDGER SYSTEM
// =============================================================================

// Ledger entry types for double-entry accounting
enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  HOLD
  RELEASE
  BUY
  SELL
  SWAP_IN
  SWAP_OUT
  SEND
  RECEIVE
  FEE
  SWEEP
  ADJUSTMENT
  REFUND
  MIGRATION       // Initial balance migration from AssetWallet
  MIGRATION_HOLD  // Migrated locked/held balance
}

// Status of a ledger entry
enum EntryStatus {
  PENDING     // Entry created but not finalized
  HOLD        // Funds reserved but not deducted
  SETTLED     // Entry finalized, balance updated
  CANCELLED   // Hold was released/refunded
  FAILED      // Entry failed to process
}

// Status of sweep operation from sub-account to main wallet
enum SweepStatus {
  PENDING         // Deposit received, sweep not started
  IN_PROGRESS     // Sweep initiated to main wallet
  COMPLETED       // Sweep confirmed on blockchain
  FAILED          // Sweep failed
  NOT_APPLICABLE  // Entry type doesn't require sweep
}

// Reason why a withdrawal was queued
enum QueueReason {
  DEPOSIT_SETTLING
  LOW_LIQUIDITY
}

// Type of ledger adjustment
enum AdjustmentType {
  CREDIT
  DEBIT
}

// Status of adjustment approval workflow
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status of data migration run
enum MigrationStatus {
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}


// Core ledger entry for double-entry accounting
// Each balance change creates an entry; balanceAfter provides O(1) balance lookup
model LedgerEntry {
  id                 String        @id @default(uuid())
  userId             Int           // 0 = platform account, -1 = network fees account
  currency           String
  type               LedgerType
  debit              Decimal       @db.Decimal(20, 8)
  credit             Decimal       @db.Decimal(20, 8)
  balanceAfter       Decimal       @db.Decimal(20, 8)
  status             EntryStatus   @default(PENDING)
  sweepStatus        SweepStatus?  // Only for DEPOSIT entries
  holdAmount         Decimal?      @db.Decimal(20, 8) // Amount held for HOLD entries
  reference          String        // External reference (txid, orderId, etc.)
  tradeGroupId       String?       // Groups related entries (e.g., buy order + fee)
  exchangeRate       Decimal?      @db.Decimal(20, 8)
  counterpartyUserId Int?          // For SEND/RECEIVE, the other party
  paymentReference   String?       // Fiat payment reference
  description        String?       // Human-readable description for audit
  metadata           Json?         // Additional data
  sequenceNumber     BigInt        @default(autoincrement()) @unique // F-001: monotonic ordering
  sweepTxId          String?       @unique                           // SW-001: webhook correlation
  sweepRetryCount    Int           @default(0)                       // SW-002: retry tracking
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User?         @relation(fields: [userId], references: [id])
  withdrawalQueue    WithdrawalQueue?
  orphanedHoldReview OrphanedHoldReview?
  auditLogs          LedgerAuditLog[]

  // Prevent duplicate entries for same transaction
  @@unique([type, reference])
  // Fast balance lookups — sequenceNumber is the canonical ordering index (F-001)
  @@index([userId, currency, sequenceNumber(sort: Desc)])
  // Retained for time-range queries (history, audit logs, reconciliation date filters)
  @@index([userId, currency, createdAt(sort: Desc)])
  @@index([status])
  @@index([sweepStatus])
  @@index([tradeGroupId])
  @@map("LedgerEntries")
}

// Per-currency float configuration for omnibus wallet
model FloatConfig {
  id              String   @id @default(uuid())
  currency        String   @unique
  floatAllowance  Decimal  @db.Decimal(20, 8) // Maximum allowed float
  alertThreshold  Decimal  @db.Decimal(5, 2)  // Alert at this % of allowance (e.g., 80.00)
  blockThreshold  Decimal  @db.Decimal(5, 2) @default(95.00) // Block deposits at this % (e.g., 95.00)
  autoApproveHours Int     @default(24)      // Auto-approve queued deposits after this many hours (0 = disabled)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("FloatConfigs")
}

// Status for deposit review queue
enum DepositReviewStatus {
  PENDING      // Awaiting admin review
  APPROVED     // Admin approved, will be credited
  REJECTED     // Admin rejected, won't be credited
  AUTO_APPROVED // Automatically approved after timeout
  EXPIRED      // Deposit window expired
}

// Queue for deposits that exceed float threshold
model DepositReviewQueue {
  id              String             @id @default(uuid())
  userId          Int
  currency        String
  amount          Decimal            @db.Decimal(20, 8)
  depositAddress  String             // Address deposit was received on
  txHash          String?            // Blockchain transaction hash
  floatAtDeposit  Decimal            @db.Decimal(5, 2)  // Float % at time of deposit
  status          DepositReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      Int?               // Admin who reviewed
  notes           String?
  autoApproveAt   DateTime?          // When auto-approve will trigger
  queuedAt        DateTime           @default(now())

  // Relations
  user            User               @relation(fields: [userId], references: [id])
  reviewer        User?              @relation("DepositReviewer", fields: [reviewedBy], references: [id])

  @@index([status, queuedAt])
  @@index([userId, currency])
  @@map("DepositReviewQueues")
}

// Queue for withdrawals waiting for liquidity
model WithdrawalQueue {
  id           String      @id @default(uuid())
  userId       Int
  currency     String
  amount       Decimal     @db.Decimal(20, 8)
  holdEntryId  String      @unique
  reason       QueueReason
  position     Int         // Queue position (1 = next to process)
  queuedAt     DateTime    @default(now())
  processedAt  DateTime?   // When withdrawal was executed
  releasedAt   DateTime?   // When HOLD was released (timeout/cancel)

  // Relations
  user         User        @relation(fields: [userId], references: [id])
  holdEntry    LedgerEntry @relation(fields: [holdEntryId], references: [id])

  @@index([currency, position])
  @@index([queuedAt])
  @@map("WithdrawalQueues")
}

// Hourly reconciliation snapshots
model ReconciliationLog {
  id                String    @id @default(uuid())
  currency          String
  ledgerTotal       Decimal   @db.Decimal(20, 8) // Sum of all user balances
  blockchainTotal   Decimal   @db.Decimal(20, 8) // Actual blockchain balance
  discrepancy       Decimal   @db.Decimal(20, 8) // Absolute difference
  discrepancyPct    Decimal   @db.Decimal(10, 4) // Percentage difference
  isWithinTolerance Boolean
  pausedWithdrawals Boolean   @default(false) // True if auto-paused
  resolvedAt        DateTime?
  resolvedBy        Int?      // Admin who resolved
  notes             String?
  createdAt         DateTime  @default(now())

  @@index([currency, createdAt(sort: Desc)])
  @@map("ReconciliationLogs")
}

// Manual ledger adjustment requests requiring super-admin approval
model AdjustmentRequest {
  id            String         @id @default(uuid())
  userId        Int            // User whose balance is adjusted
  currency      String
  amount        Decimal        @db.Decimal(20, 8)
  type          AdjustmentType
  reason        String
