  adminUserId     Int      @unique
  lastSeenQueueId String?  // Last queue item ID seen
  lastSeenAt      DateTime @default(now())

  @@map("AdminQueueSeens")
}

// =============================================================================
// ORPHANED HOLD DETECTION SYSTEM
// =============================================================================

// Resolution action for orphaned holds
enum HoldResolution {
  REFUND   // Release hold, return to available balance
  SETTLE   // Convert hold to debit (execute the original operation)
  DISMISS  // Mark as reviewed, no action needed
}

// Tracks orphaned hold entries for admin review
model OrphanedHoldReview {
  id            String          @id @default(uuid())
  ledgerEntryId String          @unique
  userId        Int
  currency      String
  amount        Decimal         @db.Decimal(20, 8)
  detectedAt    DateTime        @default(now())
  resolvedAt    DateTime?
  resolvedBy    Int?
  resolution    HoldResolution?
  notes         String?

  // Relations
  ledgerEntry   LedgerEntry     @relation(fields: [ledgerEntryId], references: [id])
  resolver      User?           @relation("OrphanedHoldResolver", fields: [resolvedBy], references: [id])

  @@index([resolvedAt])
  @@index([detectedAt])
  @@map("OrphanedHoldReviews")
}

// Actions tracked in ledger audit log
enum AuditAction {
  CREATED       // Entry created
  SETTLED       // Hold converted to debit
  FAILED        // Operation failed
  CANCELLED     // Entry cancelled
  RETRIED       // Operation retried
  HOLD_PLACED   // Hold placed on balance
  HOLD_RELEASED // Hold released back to available
}

// Audit trail for all ledger entry state changes
model LedgerAuditLog {
  id            String       @id @default(uuid())
  ledgerEntryId String
  action        AuditAction
  actor         String       // "system", "cron:<name>", "user:<id>", "admin:<id>"
  reason        String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  // Relations
  ledgerEntry   LedgerEntry  @relation(fields: [ledgerEntryId], references: [id])

  @@index([ledgerEntryId])
  @@index([createdAt])
  @@map("LedgerAuditLogs")
}

// =============================================================================
// FAILED ROLLBACK QUEUE (Swap Service Resilience)
// =============================================================================

// Status of a queued rollback
enum RollbackStatus {
  PENDING     // Awaiting retry
  PROCESSING  // Currently being processed
  COMPLETED   // Successfully rolled back
  FAILED      // Permanent failure (manual intervention needed)
}

// Persistent queue for failed rollback operations from SwapService
// If a swap fails after debiting user, the refund MUST succeed eventually
model FailedRollback {
  id            String          @id @default(uuid())
  orderId       Int             // Link to original swap order
  userId        Int             // User who needs refund
  currency      String          // Currency to refund
  amount        Decimal         @db.Decimal(20, 8) // Amount to refund
  status        RollbackStatus  @default(PENDING)
  retryCount    Int             @default(0)
  lastError     String?         // Last error message
  createdAt     DateTime        @default(now())
  lastAttemptAt DateTime?       // Last retry attempt time
  completedAt   DateTime?       // When successfully completed
  
  // Context for debugging
  originalError String          // Error that caused original rollback to fail
  metadata      Json?           // Additional context (order details, etc)
  
  // Relations
  order         Order           @relation(fields: [orderId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@index([status, createdAt]) // For cron job to find pending rollbacks
  @@index([userId])
  @@map("FailedRollbacks")
}

// =============================================================================
// SOLVENCY MONITORING (Platform Health Tracking)
// =============================================================================

// Solvency log for tracking platform reserve ratios over time
// Used by TASK-004 Solvency Monitoring Dashboard
model SolvencyLog {
  id                    String    @id @default(uuid())
  currency              String    // Currency being tracked
  userLiabilities       Decimal   @db.Decimal(20, 8) // Sum of all user virtual balances
  platformReserves      Decimal   @db.Decimal(20, 8) // Actual blockchain balance
  reserveRatio          Decimal   @db.Decimal(10, 4) // (reserves / liabilities) * 100
  pendingWithdrawals    Decimal   @db.Decimal(20, 8) // Holdings not yet settled
  effectiveReserveRatio Decimal   @db.Decimal(10, 4) // (reserves / (liabilities + pending)) * 100
  status                String    // HEALTHY, WARNING, CRITICAL
  createdAt             DateTime  @default(now())

  @@index([currency, createdAt])
  @@index([status])
  @@map("SolvencyLogs")
}

// =============================================================================
// IDENTITY DEDUPLICATION (BVN/NIN Cross-Linking)
// =============================================================================

enum IdentityIdType {
  BVN
  NIN
  NAME_DOB
}

/// Represents a single real-world person. Multiple Users CANNOT share a subject.
model IdentitySubject {
  id           Int                   @id @default(autoincrement())
  mergedIntoId Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  mergedInto   IdentitySubject?      @relation("SubjectMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   IdentitySubject[]     @relation("SubjectMerge")
  identifiers  IdentityIdentifier[]
  user         User?

  @@index([mergedIntoId])
  @@map("IdentitySubjects")
}

/// A single verified government identifier bound to exactly one IdentitySubject.
model IdentityIdentifier {
  id          Int              @id @default(autoincrement())
  subjectId   Int
  type        IdentityIdType
  valueHash   String           // SHA-256 of normalised value
  maskedValue String           // e.g. "22*****19" for admin display
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())

  subject     IdentitySubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([type, valueHash])
  @@index([subjectId])
  @@map("IdentityIdentifiers")
}
