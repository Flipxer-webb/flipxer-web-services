generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
  previewFeatures = ["fullTextSearch", "fulltextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserType {
  ADMIN
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum Country {
  NIGERIA
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  DECLINED
}

enum DocumentType {
  INTERNATIONAL_PASSPORT
  NIN
  DRIVER_LICENSE
}

enum PermissionGroup {
  USERS
}

// User model
model User {
  id                                 Int                         @id @default(autoincrement())
  identifier                         String                      @unique
  cryptoSubAccountId                 String?                     @unique
  firstName                          String?
  lastName                           String?
  username                           String?
  middleName                         String?
  email                              String                      @unique
  phone                              String?                     @unique
  password                           String?
  userType                           UserType
  photo                              String?
  gender                             Gender?
  dateOfBirth                        DateTime?
  bvn                                String?
  bvnRegisteredPhone                 String?
  country                            Country                     @default(NIGERIA)
  status                             Status                      @default(ACTIVE)
  roleId                             Int
  ipAddress                          String?
  notificationToken                  String?
  isEmailVerified                    Boolean                     @default(false)
  isPhoneVerified                    Boolean                     @default(false)
  isPasswordCreated                  Boolean                     @default(false)
  isBvnVerified                      Boolean                     @default(false)
  isDocumentVerified                 Boolean                     @default(false)
  businessRecordCompleted            Boolean                     @default(false)
  businessDocumentVerificationStatus DocumentVerificationStatus?
  isDeleted                          Boolean                     @default(false)
  createdAt                          DateTime                    @default(now())
  updatedAt                          DateTime                    @updatedAt
  passwordResetRequest               PasswordResetRequest?
  role                               Role                        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  lastLogin                          DateTime?
  loginCount                         Int                         @default(0)
  userDocument                       UserDocument?
  businessRecord                     BusinessRecord?
  businessDocument                   BusinessDocument?
  accountLimit                       AccountLimit?
  bankDetails                        BankDetail[]
  recoveryEmail                      RecoveryEmail?
  cryptoWallet                       CryptoWallet[]
  order                              Order[]

  @@index([id, bvn])
  @@map("Users")
}

// RecoveryPassword model
model RecoveryEmail {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  recoveryEmail      String? // The recovery email address
  recoveryPin        String? // 6-digit PIN
  lastPinGeneratedAt DateTime? // When the last PIN was generated

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("RecoveryEmails")
}

// AccountLimit Model
model AccountLimit {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  sellTokenFiat Int?     @default(50000)
  buyToken      String?  @default("unlimited")
  swapToken     String?  @default("unlimited")
  sendToken     Int?     @default(50000)
  receiveToken  String?  @default("unlimited")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AccountLimits")
}

// BankDetail Model
model BankDetail {
  id            Int      @id @default(autoincrement())
  userId        Int
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("BankDetails")
}

// BusinessRecord Model
model BusinessRecord {
  id                           Int    @id @default(autoincrement())
  userId                       Int?   @unique
  businessName                 String
  natureOfBusiness             String
  taxIdentificationNumber      String
  expectedTransactionVolume    String
  expectedTransactionFrequency String

  user User? @relation(fields: [userId], references: [id])

  @@map("BusinessRecords")
}

// UserDocument Model
model UserDocument {
  id                   Int          @id @default(autoincrement())
  userId               Int?         @unique
  type                 DocumentType
  country              Country
  documentNumber       String
  documentImageUrl     String
  documentImageFieldId String

  user User? @relation(fields: [userId], references: [id])

  @@map("UserDocuments")
}

// BusinessDocument Model
model BusinessDocument {
  id     Int  @id @default(autoincrement())
  userId Int? @unique

  cacDocumentNumber                           String
  cacImageUrl                                 String
  articleOfAssociationNumber                  String?
  articleOfAssociationImageUrl                String
  boardResolutionAuthorzedAcctOpeningImageUrl String
  proofOfAddressForBeneficialOwner            String
  meansOfIdentificatioForBeneficialOwner      String

  user User? @relation(fields: [userId], references: [id])

  @@map("BusinessDocuments")
}

// Account Verification
model AccountVerificationRequest {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([email, code])
  @@index([email, code])
  @@map("AccountVerificationRequests")
}

// Phone Verification
model PhoneVerificationRequest {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([phone, code])
  @@index([phone, code])
  @@map("PhoneVerificationRequests")
}

// Role model
model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  slug           String           @unique
  description    String?          @db.Text
  isAdmin        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          User[]
  rolePermission RolePermission[]

  @@map("Roles")
}

// PasswordResetRequest model
model PasswordResetRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("PasswordResetRequests")
}

// Permission model
model Permission {
  id          Int              @id @default(autoincrement())
  group       PermissionGroup
  name        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("Permissions")
}

// RolePermission model
model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("RolePermissions")
}

enum CryptoWalletStatus {
  ACTIVE
  PENDING
}

enum NetworkTypes {
  trc20
  erc20 
  bep20
}

model CryptoWallet {
  id                Int                @id @default(autoincrement())
  userId            Int
  assetSymbol       String // BTC, USDT, ETH, etc.
  walletId          String             @unique //from Quidax
  address           String? //null until webhook updates
  balance           Decimal            @default(0.0)
  converted_balance Decimal            @default(0.0)
  lastSyncedAt      DateTime?
  defaultNetwork    NetworkTypes?
  status            CryptoWalletStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, assetSymbol])
  @@map("CryptoWallets")
}

enum OrderStatus {
  pending
  filled
  partial
  cancelled
  failed
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  limit
  market
}


model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  market          String // from TradingPair enum
  orderType       String
  orderSide       OrderSide
  volume          Float
  price           Float? // optional for market orders
  status          OrderStatus
  providerOrderId String? @unique// String?  @unique // Quidax reference ID
  orderReference  String?   @unique //Quidax order ref
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("Orders")
}
