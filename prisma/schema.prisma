generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                                 Int                               @id @default(autoincrement())
  identifier                         String                            @unique
  firstName                          String?
  lastName                           String?
  username                           String?
  middleName                         String?
  email                              String                            @unique
  phone                              String?                           @unique
  password                           String?
  userType                           UserType
  photo                              String?
  gender                             Gender?
  dateOfBirth                        DateTime?
  status                             Status                            @default(ACTIVE)
  roleId                             Int
  ipAddress                          String?
  notificationToken                  String?
  isDeleted                          Boolean                           @default(false)
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  lastLogin                          DateTime?
  loginCount                         Int                               @default(0)
  businessDocumentVerificationStatus DocumentVerificationStatus?
  businessRecordCompleted            Boolean                           @default(false)
  bvn                                String?
  bvnRegisteredPhone                 String?
  country                            Country                           @default(NIGERIA)
  isBvnVerified                      Boolean                           @default(false)
  isDocumentVerified                 Boolean                           @default(false)
  isEmailVerified                    Boolean                           @default(false)
  isPasswordCreated                  Boolean                           @default(false)
  isPhoneVerified                    Boolean                           @default(false)
  cryptoSubAccountId                 String?                           @unique
  refreshToken                       String?
  businessDocumentsUploaded          Boolean                           @default(false)
  recoveryEmail                      String?
  photoFileId                        String?
  flaggedId                          Int?                              @unique
  nin                                String?
  ninRegisteredPhone                 String?
  isNinVerified                      Boolean                           @default(false)
  isAddressVerified                  Boolean                           @default(false)
  isBiometricVerified                Boolean                           @default(false)
  isIncomeVerified                   Boolean                           @default(false)
  isTwoFactorEnabled                 Boolean                           @default(false)
  tier                               Int                               @default(0)
  twoFactorSecret                    String?
  twoFactorBackupCodes               String?                           // JSON array of hashed backup codes (universal fallback)
  // Multi-factor security settings
  securityMethods                    Json?                             // {sms: boolean, email: boolean, authenticator: boolean, tradingPassword: boolean}
  requiredMethodCount                Int                               @default(1)
  backupCodesGeneratedAt             DateTime?
  // Tier 2/3 verification fields
  biometricVerifiedAt                DateTime?
  biometricCredentialId              String?
  biometricPublicKey                 String?
  documentVerificationStatus         DocumentVerificationStatus?       // Identity document verification status
  addressVerificationStatus          DocumentVerificationStatus?
  addressDocumentUrl                 String?
  incomeVerificationStatus           DocumentVerificationStatus?
  incomeDocumentUrl                  String?
  tradingPassword                    String?
  skipTwoFactorForTrustedDevices     Boolean                           @default(false)
  accountLimit                       AccountLimit?
  allowedIps                         AllowedIp[]
  assetWallets                       AssetWallet[]
  auditLogs                          AuditLog[]                        @relation("AdminAuditLogs")
  bankDetails                        BankDetail[]
  businessDocument                   BusinessDocument?
  businessRecord                     BusinessRecord?
  cryptoWalletAddressList            CryptoWalletAddress[]
  dailyTransactions                  DailyTransaction[]                @relation("UserToDailyTransaction")
  flaggedRecord                      Flagged?                          @relation("UserToFlagged")
  monthlyTransactions                MonthlyTransaction[]              @relation("UserToMonthlyTransaction")
  sentNotifications                  Notification[]                    @relation("senderNotification")
  receiverNotifications              Notification[]                    @relation("receiverNotification")
  order                              Order[]
  passwordResetRequest               PasswordResetRequest?
  payments                           Payment[]
  RecoveryEmailVerificationRequest   RecoveryEmailVerificationRequest?
  sessions                           Session[]
  userDocument                       UserDocument?
  role                               Role                              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([id, bvn])
  @@map("Users")
}

model Session {
  id             String    @id @default(uuid())
  userId         Int
  deviceName     String?
  deviceType     String?
  browser        String?
  os             String?
  ipAddress      String?
  location       String?
  deviceToken    String?   // Unique token for device recognition
  isActive       Boolean   @default(true)
  isCurrent      Boolean   @default(false)
  isTrusted      Boolean   @default(false)
  trustedAt      DateTime?
  trustExpiresAt DateTime?
  lastActiveAt   DateTime  @default(now())
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([deviceToken])
  @@map("Sessions")
}

model TransactionOTP {
  id        Int      @id @default(autoincrement())
  userId    Int
  method    String   // "sms" or "email"
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, method])
  @@index([userId])
  @@map("TransactionOTPs")
}

model Flagged {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  flagged   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToFlagged", fields: [userId], references: [id], onDelete: Cascade)

  @@map("Flagged")
}

model DailyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  day       Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToDailyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, day])
  @@map("DailyTransactions")
}

model MonthlyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToMonthlyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("MonthlyTransactions")
}

model AccountLimit {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  sellTokenFiat Int?     @default(50000)
  buyToken      String?  @default("unlimited")
  swapToken     String?  @default("unlimited")
  sendToken     Int?     @default(50000)
  receiveToken  String?  @default("unlimited")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AccountLimits")
}

model BankDetail {
  id            Int      @id @default(autoincrement())
  userId        Int
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankCode      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
  @@map("BankDetails")
}

model BusinessRecord {
  id                           Int    @id @default(autoincrement())
  userId                       Int?   @unique
  businessName                 String
  natureOfBusiness             String
  taxIdentificationNumber      String
  expectedTransactionVolume    String
  expectedTransactionFrequency String
  user                         User?  @relation(fields: [userId], references: [id])

  @@map("BusinessRecords")
}

model UserDocument {
  id                       Int                         @id @default(autoincrement())
  userId                   Int?                        @unique
  type                     DocumentType
  country                  Country
  documentNumber           String
  documentImageUrl         String
  documentImageFieldId     String
  documentImage2FieldId    String?
  documentImageUrl2        String?
  // Dojah verification fields
  verificationStatus       DocumentVerificationStatus  @default(PENDING)
  dojahVerified            Boolean                     @default(false)
  dojahDocumentType        String?                     // e.g., "International Passport - Nigeria"
  dojahCountryCode         String?                     // e.g., "NGA"
  dojahExtractedFirstName  String?
  dojahExtractedLastName   String?
  dojahExtractedDob        String?
  dojahExtractedDocNumber  String?
  dojahNameMatches         Boolean?
  dojahVerifiedAt          DateTime?
  dojahRawResponse         String?                     // JSON string of full response for audit
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  user                     User?                       @relation(fields: [userId], references: [id])

  @@map("UserDocuments")
}

model BusinessDocument {
  id                                                  Int     @id @default(autoincrement())
  userId                                              Int?    @unique
  cacDocumentNumber                                   String
  cacImageUrl                                         String
  articleOfAssociationNumber                          String?
  articleOfAssociationImageUrl                        String?
  proofOfAddressForBeneficialOwner                    String?
  articleOfAssociationImageUrlFieldId                 String?
  boardResolutionAuthorizedAcctOpeningImageUrl        String?
  boardResolutionAuthorizedAcctOpeningImageUrlFieldId String?
  cacImageUrlFieldId                                  String
  meansOfIdentificationForBeneficialOwner             String?
  meansOfIdentificationForBeneficialOwnerImageFieldId String?
  proofOfAddressForBeneficialOwnerImageFieldId        String?
  articleOfAssociationFileName                        String?
  boardResolutionAuthorizedAcctOpeningFileName        String?
  cacImageFileName                                    String?
  meansOfIdentificationForBeneficialOwnerFileName     String?
  proofOfAddressForBeneficialOwnerFileName            String?
  user                                                User?   @relation(fields: [userId], references: [id])

  @@map("BusinessDocuments")
}

model AccountVerificationRequest {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([email, code])
  @@index([email, code])
  @@map("AccountVerificationRequests")
}

model PhoneVerificationRequest {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([phone, code])
  @@index([phone, code])
  @@map("PhoneVerificationRequests")
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  slug           String           @unique
  description    String?
  isAdmin        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rolePermission RolePermission[]
  users          User[]

  @@map("Roles")
}

model PasswordResetRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("PasswordResetRequests")
}

model Permission {
  id          Int              @id @default(autoincrement())
  group       PermissionGroup
  name        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("RolePermissions")
}

model AssetWallet {
  id                String   @id @default(uuid())
  userId            Int
  quidaxWalletId    String   @unique
  assetName         String
  assetCurrency     String
  balance           Decimal  @db.Decimal(20, 18)
  locked            Decimal  @db.Decimal(20, 18)
  staked            Decimal  @db.Decimal(20, 18)
  convertedBalance  Decimal  @db.Decimal(20, 8)
  referenceCurrency String
  isCrypto          Boolean
  defaultNetwork    String
  blockchainEnabled Boolean
  depositAddress    String?
  destinationTag    String?
  isActive          Boolean  @default(false)
  addressSynced     Boolean  @default(false)
  networks          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, assetCurrency])
  @@index([userId])
  @@index([assetCurrency])
  @@map("AssetWallets")
}

model CryptoWalletAddress {
  id              Int                @id @default(autoincrement())
  userId          Int
  assetSymbol     String
  walletAddressId String             @unique
  address         String?
  totalPayments   Decimal            @default(0.0)
  lastSyncedAt    DateTime?
  network         NetworkTypes?
  destination_tag String?
  status          CryptoWalletStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])

  @@unique([userId, assetSymbol, network])
  @@map("CryptoWalletAddresses")
}

model Order {
  id                           Int                    @id @default(autoincrement())
  userId                       Int
  orderCategory                OrderCategory
  market                       String?
  orderType                    OrderType?
  orderSide                    OrderSide?
  volume                       Float?
  price                        Float?
  status                       OrderStatus
  quotationId                  String?
  fromCurrency                 String?
  toCurrency                   String?
  fromAmount                   Float?
  toAmount                     Float?
  quoted_price                 Float?
  quoted_currency              String?
  executionPrice               Float?
  swapExpiresAt                DateTime?
  currency                     String?
  narration                    String?
  reason                       String?
  transaction_note             String?
  recipient                    String?
  amount                       Float?
  fee                          Float?
  total                        Float?
  sourceType                   String?
  blockchain_txid              String?
  providerOrderId              String?                @unique
  orderReference               String?                @unique
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  destinationBankAccountName   String?
  destinationBankAccountNumber String?
  destinationBankCode          String?
  destinationBankName          String?
  destinationTag               String?
  paymentStatus                TransactionStatus?
  totalToReceiveInFiat         Float?
  amountInFiat                 Float?
  rateAtConversion             Float?
  referenceFiatCurrency        ReferenceFiatCurrency  @default(NGN)
  sender                       String?
  streamlinedStatus            OrderStreamlinedStatus @default(pending)
  transactionId                String?                @unique
  user                         User                   @relation(fields: [userId], references: [id])
  payments                     Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([streamlinedStatus])
  @@index([orderCategory])
  @@map("Orders")
}

model Bank {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  code      String   @unique
  longCode  String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Banks")
}

model CryptoRate {
  id        Int      @id @default(autoincrement())
  currency  String   @unique
  buyRate   Float    @default(0)
  sellRate  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("CryptoRates")
}

model TransactionFee {
  id        Int                    @id @default(autoincrement())
  category  TransactionFeeCategory
  currency  String
  fee       Float                  @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([category, currency])
  @@map("TransactionFees")
}

model Payment {
  id                           Int               @id @default(autoincrement())
  userId                       Int
  orderId                      Int?
  amount                       Decimal           @db.Decimal(10, 2)
  chargeFee                    Decimal           @default(0.0) @db.Decimal(10, 2)
  totalAmount                  Decimal?          @db.Decimal(10, 2)
  expectedCurrency             String?
  status                       TransactionStatus
  type                         TransactionType?
  flow                         TransactionFlow?
  paymentStatus                TransactionStatus @default(PENDING)
  transactionId                String?           @unique
  paymentMethod                PaymentMethod
  sessionId                    String
  title                        String
  narration                    String
  reference                    String            @unique
  externalReference            String?
  destinationBankAccountName   String?
  destinationBankName          String?
  destinationBankAccountNumber String?
  shortDescription             String?
  isDebit                      Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  order                        Order?            @relation(fields: [orderId], references: [id])
  user                         User              @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("Payments")
}

model AllowedIp {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, ip])
  @@index([userId])
  @@map("AllowedIps")
}

model RecoveryEmailVerificationRequest {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  email      String
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("RecoveryEmailVerificationRequests")
}

model Notification {
  id              Int                     @id @default(autoincrement())
  title           String
  body            String?
  isRead          Boolean                 @default(false)
  senderId        Int?
  userId          Int?
  target          UserNotificationTarget  @default(ALL)
  beneficiary     NotificationBeneficiary
  type            NotificationType        @default(MESSAGE)
  status          NotificationStatus      @default(PENDING)
  transactionType OrderCategory?
  currency        String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  sender          User?                   @relation("senderNotification", fields: [senderId], references: [id])
  receiver        User?                   @relation("receiverNotification", fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("Notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      User?    @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("AuditLogs")
}

model KycVerification {
  id               Int                 @id @default(autoincrement())
  userId           Int
  verificationType KycVerificationType
  status           KycStatus           @default(PENDING)
  reviewerId       Int?
  reviewNote       String?
  documentUrl      String?
  submittedAt      DateTime            @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([verificationType])
  @@map("KycVerifications")
}

model LiquidityAlert {
  id           Int                  @id @default(autoincrement())
  currency     String
  alertType    LiquidityAlertType
  threshold    Decimal              @db.Decimal(20, 8)
  currentValue Decimal?             @db.Decimal(20, 8)
  status       LiquidityAlertStatus @default(PENDING)
  resolvedBy   Int?
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([currency])
  @@index([status])
  @@index([createdAt])
  @@map("LiquidityAlerts")
}

model SlackWebhook {
  id            Int       @id @default(autoincrement())
  name          String
  webhookUrl    String
  channel       String?
  alertTypes    String[]
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("SlackWebhooks")
}

model AlertCooldown {
  id              Int      @id @default(autoincrement())
  alertKey        String   @unique
  lastAlertedAt   DateTime
  cooldownMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([alertKey])
  @@map("AlertCooldowns")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("SystemSettings")
}

model FeatureFlag {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  name        String
  description String?
  isEnabled   Boolean               @default(false)
  conditions  Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  auditLogs   FeatureFlagAuditLog[]

  @@index([key])
  @@index([isEnabled])
  @@map("FeatureFlags")
}

model FeatureFlagAuditLog {
  id             Int               @id @default(autoincrement())
  flagId         Int
  action         FeatureFlagAction
  previousValue  Json?
  newValue       Json?
  changedById    Int
  changedByEmail String?
  reason         String?
  createdAt      DateTime          @default(now())
  flag           FeatureFlag       @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([changedById])
  @@index([createdAt])
  @@map("FeatureFlagAuditLogs")
}

enum UserType {
  ADMIN
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum Country {
  NIGERIA
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  DECLINED
}

enum DocumentType {
  INTERNATIONAL_PASSPORT
  NIN
  DRIVER_LICENSE
}

enum PermissionGroup {
  USERS
  TRANSACTIONS
  SETTINGS
  ANALYTICS
  KYC
  NOTIFICATIONS
  ROLES
  SYSTEM
}

enum CryptoWalletStatus {
  ACTIVE
  PENDING
}

enum NetworkTypes {
  trc20
  erc20
  bep20
  btc
  ltc
  dash
  doge
  bch
  ripple
  stellar
  cardano
  solana
  polygon
  celo
  optimism
  ton
  arbitrum
  base
}

enum OrderStatus {
  pending
  filled
  partial
  cancelled
  failed
  confirmed
  initiated
  completed
  reversed
  done
  processing
  rejected
  submitted
  on_hold
  accepted
}

enum OrderStreamlinedStatus {
  pending
  completed
  failed
  cancelled
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  limit
  market
}

enum OrderCategory {
  BUY
  SELL
  SWAP
  SEND
  RECEIVE
}

enum ReferenceFiatCurrency {
  NGN
}

enum TransactionFeeCategory {
  BUY
  SELL
  SWAP
  SEND
}

enum PaymentMethod {
  FINCRA
}

enum TransactionStatus {
  PENDING
  SUCCESS
  APPROVED
  FAILED
  DECLINED
  REVERSAL
  ABANDONED
}

enum TransactionType {
  P2P_PAYMENT
  TRANSFER_FUND
}

enum TransactionFlow {
  IN
  OUT
}

enum NotificationType {
  PUSH_NOTIFICATION
  MESSAGE
}

enum NotificationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationBeneficiary {
  ALL
  INDIVIDUAL
}

enum UserNotificationTarget {
  ALL
  SINGLE
}

enum KycVerificationType {
  BVN
  NIN
  DOCUMENT
  ADDRESS
  BIOMETRIC
  INCOME
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum LiquidityAlertType {
  LOW_BALANCE
  HIGH_BALANCE
  UNUSUAL_ACTIVITY
  RATE_DEVIATION
}

enum LiquidityAlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum FeatureFlagAction {
  CREATED
  ENABLED
  DISABLED
  CONDITIONS_UPDATED
  DELETED
}
