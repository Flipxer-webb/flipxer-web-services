generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                                 Int                               @id @default(autoincrement())
  identifier                         String                            @unique
  cryptoSubAccountId                 String?                           @unique
  firstName                          String?
  lastName                           String?
  username                           String?
  middleName                         String?
  email                              String                            @unique
  phone                              String?                           @unique
  password                           String?
  userType                           UserType
  photo                              String?
  gender                             Gender?
  dateOfBirth                        DateTime?
  bvn                                String?
  bvnRegisteredPhone                 String?
  nin                                String?
  ninRegisteredPhone                 String?
  country                            Country                           @default(NIGERIA)
  status                             Status                            @default(ACTIVE)
  roleId                             Int
  ipAddress                          String?
  notificationToken                  String?
  tier                               Int                               @default(0)
  isEmailVerified                    Boolean                           @default(false)
  isPhoneVerified                    Boolean                           @default(false)
  isPasswordCreated                  Boolean                           @default(false)
  isBvnVerified                      Boolean                           @default(false)
  isNinVerified                      Boolean                           @default(false)
  isDocumentVerified                 Boolean                           @default(false)
  isAddressVerified                  Boolean                           @default(false)
  isBiometricVerified                Boolean                           @default(false)
  isIncomeVerified                   Boolean                           @default(false)
  businessRecordCompleted            Boolean                           @default(false)
  businessDocumentVerificationStatus DocumentVerificationStatus?
  isTwoFactorEnabled                 Boolean                           @default(false)
  twoFactorSecret                    String?
  isDeleted                          Boolean                           @default(false)
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  lastLogin                          DateTime?
  loginCount                         Int                               @default(0)
  refreshToken                       String?
  businessDocumentsUploaded          Boolean                           @default(false)
  recoveryEmail                      String?
  photoFileId                        String?
  flaggedId                          Int?                              @unique
  accountLimit                       AccountLimit?
  allowedIps                         AllowedIp[]
  assetWallets                       AssetWallet[]
  bankDetails                        BankDetail[]
  businessDocument                   BusinessDocument?
  businessRecord                     BusinessRecord?
  cryptoWalletAddressList            CryptoWalletAddress[]
  dailyTransactions                  DailyTransaction[]                @relation("UserToDailyTransaction")
  flaggedRecord                      Flagged?                          @relation("UserToFlagged")
  monthlyTransactions                MonthlyTransaction[]              @relation("UserToMonthlyTransaction")
  sentNotifications                  Notification[]                    @relation("senderNotification")
  receiverNotifications              Notification[]                    @relation("receiverNotification")
  order                              Order[]
  passwordResetRequest               PasswordResetRequest?
  payments                           Payment[]
  RecoveryEmailVerificationRequest   RecoveryEmailVerificationRequest?
  userDocument                       UserDocument?
  sessions                           Session[]
  role                               Role                              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  auditLogs                          AuditLog[]                        @relation("AdminAuditLogs")

  @@index([id, bvn])
  @@map("Users")
}

model Session {
  id           String    @id @default(uuid())
  userId       Int
  deviceName   String?
  deviceType   String?
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  isActive     Boolean   @default(true)
  isCurrent    Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("Sessions")
}

model Flagged {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  flagged   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToFlagged", fields: [userId], references: [id], onDelete: Cascade)

  @@map("Flagged")
}

model DailyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  day       Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToDailyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, day])
  @@map("DailyTransactions")
}

model MonthlyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  year      Int
  month     Int
  totalUSD  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserToMonthlyTransaction", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("MonthlyTransactions")
}

model AccountLimit {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  sellTokenFiat Int?     @default(50000)
  buyToken      String?  @default("unlimited")
  swapToken     String?  @default("unlimited")
  sendToken     Int?     @default(50000)
  receiveToken  String?  @default("unlimited")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AccountLimits")
}

model BankDetail {
  id            Int      @id @default(autoincrement())
  userId        Int
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankCode      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
  @@map("BankDetails")
}

model BusinessRecord {
  id                           Int    @id @default(autoincrement())
  userId                       Int?   @unique
  businessName                 String
  natureOfBusiness             String
  taxIdentificationNumber      String
  expectedTransactionVolume    String
  expectedTransactionFrequency String
  user                         User?  @relation(fields: [userId], references: [id])

  @@map("BusinessRecords")
}

model UserDocument {
  id                    Int          @id @default(autoincrement())
  userId                Int?         @unique
  type                  DocumentType
  country               Country
  documentNumber        String
  documentImageUrl      String
  documentImageFieldId  String
  documentImage2FieldId String?
  documentImageUrl2     String?
  user                  User?        @relation(fields: [userId], references: [id])

  @@map("UserDocuments")
}

model BusinessDocument {
  id                                                  Int     @id @default(autoincrement())
  userId                                              Int?    @unique
  cacDocumentNumber                                   String
  cacImageUrl                                         String
  articleOfAssociationNumber                          String?
  articleOfAssociationImageUrl                        String?
  proofOfAddressForBeneficialOwner                    String?
  articleOfAssociationImageUrlFieldId                 String?
  boardResolutionAuthorizedAcctOpeningImageUrl        String?
  boardResolutionAuthorizedAcctOpeningImageUrlFieldId String?
  cacImageUrlFieldId                                  String
  meansOfIdentificationForBeneficialOwner             String?
  meansOfIdentificationForBeneficialOwnerImageFieldId String?
  proofOfAddressForBeneficialOwnerImageFieldId        String?
  articleOfAssociationFileName                        String?
  boardResolutionAuthorizedAcctOpeningFileName        String?
  cacImageFileName                                    String?
  meansOfIdentificationForBeneficialOwnerFileName     String?
  proofOfAddressForBeneficialOwnerFileName            String?
  user                                                User?   @relation(fields: [userId], references: [id])

  @@map("BusinessDocuments")
}

model AccountVerificationRequest {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([email, code])
  @@index([email, code])
  @@map("AccountVerificationRequests")
}

model PhoneVerificationRequest {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)

  @@unique([phone, code])
  @@index([phone, code])
  @@map("PhoneVerificationRequests")
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  slug           String           @unique
  description    String?
  isAdmin        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rolePermission RolePermission[]
  users          User[]

  @@map("Roles")
}

model PasswordResetRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("PasswordResetRequests")
}

model Permission {
  id          Int              @id @default(autoincrement())
  group       PermissionGroup
  name        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("RolePermissions")
}

model AssetWallet {
  id                String   @id @default(uuid())
  userId            Int
  quidaxWalletId    String   @unique
  assetName         String
  assetCurrency     String
  balance           Decimal  @db.Decimal(20, 18)
  locked            Decimal  @db.Decimal(20, 18)
  staked            Decimal  @db.Decimal(20, 18)
  convertedBalance  Decimal  @db.Decimal(20, 8)
  referenceCurrency String
  isCrypto          Boolean
  defaultNetwork    String
  blockchainEnabled Boolean
  depositAddress    String?
  destinationTag    String?
  isActive          Boolean  @default(false)
  addressSynced     Boolean  @default(false)
  networks          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, assetCurrency])
  @@index([userId])
  @@index([assetCurrency])
  @@map("AssetWallets")
}

model CryptoWalletAddress {
  id              Int                @id @default(autoincrement())
  userId          Int
  assetSymbol     String
  walletAddressId String             @unique
  address         String?
  totalPayments   Decimal            @default(0.0)
  lastSyncedAt    DateTime?
  network         NetworkTypes?
  destination_tag String?
  status          CryptoWalletStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])

  @@unique([userId, assetSymbol, network])
  @@map("CryptoWalletAddresses")
}

model Order {
  id                           Int                    @id @default(autoincrement())
  userId                       Int
  orderCategory                OrderCategory
  market                       String?
  orderType                    OrderType?
  orderSide                    OrderSide?
  volume                       Float?
  price                        Float?
  status                       OrderStatus
  quotationId                  String?
  fromCurrency                 String?
  toCurrency                   String?
  fromAmount                   Float?
  toAmount                     Float?
  quoted_price                 Float?
  quoted_currency              String?
  executionPrice               Float?
  swapExpiresAt                DateTime?
  currency                     String?
  narration                    String?
  reason                       String?
  transaction_note             String?
  recipient                    String?
  amount                       Float?
  fee                          Float?
  total                        Float?
  sourceType                   String?
  blockchain_txid              String?
  providerOrderId              String?                @unique
  orderReference               String?                @unique
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  destinationTag               String?
  paymentStatus                TransactionStatus?
  destinationBankAccountName   String?
  destinationBankAccountNumber String?
  destinationBankCode          String?
  destinationBankName          String?
  totalToReceiveInFiat         Float?
  streamlinedStatus            OrderStreamlinedStatus @default(pending)
  amountInFiat                 Float?
  rateAtConversion             Float?
  referenceFiatCurrency        ReferenceFiatCurrency  @default(NGN)
  transactionId                String?                @unique
  sender                       String?
  user                         User                   @relation(fields: [userId], references: [id])
  payments                     Payment[]

  @@map("Orders")
}

model Bank {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  code      String   @unique
  longCode  String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Banks")
}

model CryptoRate {
  id        Int      @id @default(autoincrement())
  currency  String   @unique
  buyRate   Float    @default(0)
  sellRate  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("CryptoRates")
}

model TransactionFee {
  id        Int                    @id @default(autoincrement())
  category  TransactionFeeCategory
  currency  String
  fee       Float                  @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([category, currency])
  @@map("TransactionFees")
}

model Payment {
  id                           Int               @id @default(autoincrement())
  userId                       Int
  orderId                      Int?
  amount                       Decimal           @db.Decimal(10, 2)
  chargeFee                    Decimal           @default(0.0) @db.Decimal(10, 2)
  totalAmount                  Decimal?          @db.Decimal(10, 2)
  expectedCurrency             String?
  status                       TransactionStatus
  type                         TransactionType?
  paymentStatus                TransactionStatus @default(PENDING)
  transactionId                String?           @unique
  paymentMethod                PaymentMethod
  sessionId                    String
  title                        String
  narration                    String
  reference                    String            @unique
  externalReference            String?
  isDebit                      Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  destinationBankAccountName   String?
  destinationBankAccountNumber String?
  destinationBankName          String?
  flow                         TransactionFlow?
  shortDescription             String?
  order                        Order?            @relation(fields: [orderId], references: [id])
  user                         User              @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("Payments")
}

model AllowedIp {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, ip])
  @@index([userId])
  @@map("AllowedIps")
}

model RecoveryEmailVerificationRequest {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  email      String
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isVerified Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("RecoveryEmailVerificationRequests")
}

model Notification {
  id              Int                     @id @default(autoincrement())
  title           String
  body            String?
  isRead          Boolean                 @default(false)
  senderId        Int?
  userId          Int?
  target          UserNotificationTarget  @default(ALL)
  beneficiary     NotificationBeneficiary
  type            NotificationType        @default(MESSAGE)
  status          NotificationStatus      @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  currency        String?
  transactionType OrderCategory?
  sender          User?                   @relation("senderNotification", fields: [senderId], references: [id])
  receiver        User?                   @relation("receiverNotification", fields: [userId], references: [id])

  @@map("Notifications")
}

enum UserType {
  ADMIN
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum Country {
  NIGERIA
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  DECLINED
}

enum DocumentType {
  INTERNATIONAL_PASSPORT
  NIN
  DRIVER_LICENSE
}

enum PermissionGroup {
  USERS
  TRANSACTIONS
  SETTINGS
  ANALYTICS
  KYC
  NOTIFICATIONS
  ROLES
  SYSTEM
}

enum CryptoWalletStatus {
  ACTIVE
  PENDING
}

enum NetworkTypes {
  trc20
  erc20
  bep20
  btc
  ltc
  dash
  doge
  bch
  ripple
  stellar
  cardano
  solana
  polygon
  celo
  optimism
  ton
  arbitrum
  base
}

enum OrderStatus {
  pending
  filled
  partial
  cancelled
  failed
  confirmed
  initiated
  completed
  reversed
  done
  processing
  rejected
  submitted
  on_hold
  accepted
}

enum OrderStreamlinedStatus {
  pending
  completed
  failed
  cancelled
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  limit
  market
}

enum OrderCategory {
  BUY
  SELL
  SWAP
  SEND
  RECEIVE
}

enum ReferenceFiatCurrency {
  NGN
}

enum TransactionFeeCategory {
  BUY
  SELL
  SWAP
  SEND
}

enum PaymentMethod {
  FINCRA
}

enum TransactionStatus {
  PENDING
  SUCCESS
  APPROVED
  FAILED
  DECLINED
  REVERSAL
  ABANDONED
}

enum TransactionType {
  P2P_PAYMENT
  TRANSFER_FUND
}

enum TransactionFlow {
  IN
  OUT
}

enum NotificationType {
  PUSH_NOTIFICATION
  MESSAGE
}

enum NotificationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationBeneficiary {
  ALL
  INDIVIDUAL
}

enum UserNotificationTarget {
  ALL
  SINGLE
}

// ==================== ADMIN AUDIT LOG ====================

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      User?    @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("AuditLogs")
}

// ==================== KYC VERIFICATION ====================

model KycVerification {
  id             Int                  @id @default(autoincrement())
  userId         Int
  verificationType KycVerificationType
  status         KycStatus            @default(PENDING)
  reviewerId     Int?
  reviewNote     String?
  documentUrl    String?
  submittedAt    DateTime             @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([verificationType])
  @@map("KycVerifications")
}

enum KycVerificationType {
  BVN
  NIN
  DOCUMENT
  ADDRESS
  BIOMETRIC
  INCOME
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}
