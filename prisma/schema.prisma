// Track data migration progress for resume capability
model MigrationRun {
  id             String          @id @default(uuid())
  name           String          // Migration identifier
  lastUserId     Int             @default(0) // Last successfully migrated user
  totalUsers     Int             @default(0)
  processedUsers Int             @default(0)
  status         MigrationStatus @default(RUNNING)
